<?xml version="1.0" encoding="utf-8"?>
<!-- The wider widget sizes (1x3, 1x4): the same card with a thin city
     skyline along the bottom, set in from the rounded corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/sol_widget_bg" />
    <item
        android:bottom="1dp"
        android:drawable="@drawable/sol_widget_skyline"
        android:gravity="bottom|fill_horizontal"
        android:height="16dp"
        android:left="20dp"
        android:right="20dp" />
</layer-list>
