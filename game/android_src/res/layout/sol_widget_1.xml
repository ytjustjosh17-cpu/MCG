<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1: sun, the figure, "/h". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sol_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sol_widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <ImageView
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginBottom="2dp"
        android:importantForAccessibility="no"
        android:src="@drawable/sol_widget_sun" />

    <TextView
        android:id="@+id/sol_rate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:text="£0"
        android:textColor="#D8E6E3"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sol_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="/h"
        android:textColor="#8FAAA6"
        android:textSize="11sp" />
</LinearLayout>
