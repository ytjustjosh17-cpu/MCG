<?xml version="1.0" encoding="utf-8"?>
<!-- 1x4: a bigger sun and figure with room to breathe, the name on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sol_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sol_widget_bg_wide"
    android:paddingBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/sol_widget_sun" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sol_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="£0"
            android:fontFamily="sans-serif-medium"
            android:textColor="#EEF6F3"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sol_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="income an hour"
            android:textColor="#8FB0AB"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.22"
        android:fontFamily="sans-serif-medium"
        android:text="SOL"
        android:textColor="#5E8481"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
