<?xml version="1.0" encoding="utf-8"?>
<!-- 1x3: sun, the figure, "income an hour", and the name on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sol_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sol_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/sol_widget_sun" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sol_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="£0"
            android:textColor="#D8E6E3"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sol_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="income an hour"
            android:textColor="#8FAAA6"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.15"
        android:text="SOL"
        android:textColor="#4F6E6C"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
